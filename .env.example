# Copy this file to .env (or set these in Replit Secrets) — never commit real values.

# PostgreSQL connection string used by Prisma.
# On Replit this is provided automatically by the built-in database.
DATABASE_URL=

# Sportmonks Football API V3 token.
# Server-only. Never expose this to the frontend, never commit a real value.
# Store the real token in Replit Secrets, not in this file.
SPORTMONKS_API_TOKEN=
